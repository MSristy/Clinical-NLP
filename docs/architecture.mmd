flowchart TB
  subgraph PREP[Knowledge preparation — implemented]
    P[Protocol PDFs] --> E[Extract + visual review]
    E --> C[Canonical cards]
    C --> DB[(BM25 index)]
  end
  subgraph RUN[Recommendation engine — implemented]
    I[Patient facts] --> R[Retrieve cards]
    R -->|Baseline| M[Qwen model]
    R --> X[Applicability preview — Improved only]
    X --> M
    M --> K[Shared applicability + missing-info checks]
    K --> O[Care plan + source citations]
    K --> L[Saved run + evidence log]
    R --> Z[Zero cards: no model call]
  end
  DB --> R
  subgraph FUTURE[Future integrations — design only]
    N[NER + clinician confirmation]
    A[Doctor acceptance]
    RX[Prescription draft + signature]
    F[Feedback + governed review]
  end
  N -.-> I
  O -.-> A
  A -.-> RX
  A -.-> F
  F -.-> C
  classDef implemented fill:#eef9f8,stroke:#087f8c,color:#18364d;
  class P,E,C,DB,I,R,M,K,O,L,Z implemented;
  classDef tested fill:#fff7e8,stroke:#b77913,color:#18364d;
  class X tested;
  classDef future fill:#fbf8ff,stroke:#8461b5,color:#18364d;
  class N,A,RX,F future;
